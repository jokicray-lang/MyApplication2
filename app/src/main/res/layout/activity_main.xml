<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- ======================================================= -->
    <!-- 1. 左侧：相机与视觉层 (占据剩余空间) -->
    <!-- ======================================================= -->

    <!-- 相机预览 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/controlContainer" />

    <!-- 骨架绘制层 -->
    <com.example.myapplication.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/viewFinder"
        app:layout_constraintTop_toTopOf="@id/viewFinder"
        app:layout_constraintBottom_toBottomOf="@id/viewFinder"
        app:layout_constraintEnd_toEndOf="@id/viewFinder" />

    <!-- 评分圆圈 -->
    <TextView
        android:id="@+id/tvScore"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_score_circle"
        android:gravity="center"
        android:text="--"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="@id/viewFinder"
        app:layout_constraintEnd_toEndOf="@id/viewFinder" />

    <!-- 纠正提示 -->
    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="#80000000"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:elevation="10dp"
        app:layout_constraintTop_toBottomOf="@+id/tvScore"
        app:layout_constraintEnd_toEndOf="@id/viewFinder" />

    <!-- ======================================================= -->
    <!-- 2. 右侧：控制面板 (固定宽度 380dp) -->
    <!-- ======================================================= -->
    <ScrollView
        android:id="@+id/controlContainer"
        android:layout_width="380dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:fillViewport="true"
        android:elevation="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 标题 -->
            <TextView
                android:text="Exercise Data"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:textSize="18sp"
                android:layout_marginBottom="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- 计数显示行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp">

                <TextView
                    android:text="Count:"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvCount"
                    android:text="0"
                    android:textSize="50sp"
                    android:textStyle="bold"
                    android:textColor="#2ECC71"
                    android:gravity="center"
                    android:background="@drawable/bg_counter_box"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- 状态显示 -->
            <TextView
                android:id="@+id/tvStage"
                android:text="Ready"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#3498DB"
                android:gravity="center"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- [修改处] 下拉选择区域 -->
            <TextView
                android:text="Select Exercise:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Spinner 加高、加背景 -->
            <Spinner
                android:id="@+id/spinnerExercise"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@android:drawable/btn_dropdown"
                android:entries="@array/exercise_types"
                android:layout_marginBottom="15dp"/>

            <!-- 功能按钮：各自独占一行 -->

            <!-- 1. 切换镜头 -->
            <Button
                android:id="@+id/btnSwitchCamera"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="切换镜头"
                android:textSize="14sp"
                android:backgroundTint="#607D8B"
                android:layout_marginBottom="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <!-- 2. 查看历史 -->
            <Button
                android:id="@+id/btnHistory"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="查看历史记录"
                android:textSize="14sp"
                android:backgroundTint="#673AB7"
                android:layout_marginBottom="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <!-- 占位符：把底部按钮顶到底下 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 底部 2x2 按钮网格 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">

                <!-- 第一行：微调按钮 (- 和 +) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnDecrease"
                        android:text="-"
                        android:textSize="24sp"
                        android:backgroundTint="#FF9800"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="55dp"
                        android:layout_marginEnd="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                    <Button
                        android:id="@+id/btnIncrease"
                        android:text="+"
                        android:textSize="24sp"
                        android:backgroundTint="#4CAF50"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="55dp"
                        android:layout_marginStart="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>

                <!-- 第二行：操作按钮 (重置 和 开始) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnReset"
                        android:text="重置"
                        android:textSize="16sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#95A5A6"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="60dp"
                        android:layout_marginEnd="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                    <Button
                        android:id="@+id/btnStartTraining"
                        android:text="开始训练"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:backgroundTint="#2196F3"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="60dp"
                        android:layout_marginStart="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                    <Button
                        android:id="@+id/btnStopTraining"
                        android:text="结束并保存"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="#F44336"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="60dp"
                        android:layout_marginStart="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>